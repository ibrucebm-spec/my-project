# Port serwera (aplikacja dostępna tylko na tym komputerze; HOST=0.0.0.0 udostępnia ją w sieci)
PORT=3000

# Token wymagany przez endpoint /api/bars (cBot z cTradera albo EA z MT5). start.bat ustawia go sam.
INGEST_TOKEN=zmien-mnie-na-dlugi-losowy-token

# Interwał świec wysyłanych przez cBota (Minute15 = M15). Wyższe interwały (H1, H4) AI buduje samo.
AI_TIMEFRAME=M15

# Strategie w laboratorium, po przecinku: INTERWAŁ:SL_ATR:TP_ATR:MAKS_ŚWIEC
# np. H1:1:1.5:12 = świece H1, stop loss 1×ATR, take profit 1,5×ATR, najwyżej 12 świec (12 h)
AI_STRATEGIES=M15:1:1.5:16,M15:1.5:3:32,H1:1:1.5:12,H1:1.5:3:24,H4:1:1.5:6,H4:1.5:3:12

# Rynki powiązane (maks. 3), te same co w cBocie w parametrze "Related symbols"
AI_AUX_SYMBOLS=EURUSD,XAGUSD,USDJPY

# Spread + prowizja w USD na uncję (sprawdź u swojego brokera)
AI_COST_USD=0.35
# Ile wyników strategia musi przerobić, zanim cokolwiek podpowie
AI_MIN_SAMPLES=1000
# Wymagana przewaga prawdopodobieństwa nad progiem opłacalności
AI_MIN_EDGE=0.05
# Bazowy próg dowodu przewagi (t-stat); AI podnosi go automatycznie o poprawkę na liczbę strategii
AI_MIN_TSTAT=1.5

# Zarządzanie ryzykiem
# Ryzyko na transakcję w % salda (z tego liczona jest wielkość pozycji)
AI_RISK_PCT=1
# Po takiej stracie w ciągu dnia (w R) desk przestaje podpowiadać do jutra
AI_DAILY_LOSS_R=3
# Blokada sygnałów, gdy spread jest tyle razy większy niż AI_COST_USD (np. przy newsach)
AI_MAX_SPREAD_X=2
