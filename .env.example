# Port serwera (aplikacja dostępna tylko na tym komputerze; HOST=0.0.0.0 udostępnia ją w sieci)
PORT=3000

# Token wymagany przez endpoint /api/bars (cBot z cTradera albo EA z MT5). Ustaw długi losowy ciąg!
INGEST_TOKEN=zmien-mnie-na-dlugi-losowy-token

# Interwał świec, na których uczy się AI (musi być taki sam jak w cBocie: M15 = Minute15, H1 = Hour): M5, M15, M30, H1, H4
AI_TIMEFRAME=M15
# Ile świec maksymalnie trwa transakcja (potem zamknięcie po cenie rynkowej)
AI_HORIZON_BARS=16
# Stop loss i take profit w wielokrotnościach ATR(14)
AI_SL_ATR=1.0
AI_TP_ATR=1.5
# Spread + prowizja w USD na uncję (sprawdź u swojego brokera)
AI_COST_USD=0.35
# Ile wyników model musi przerobić, zanim cokolwiek podpowie
AI_MIN_SAMPLES=1000
# Wymagana przewaga prawdopodobieństwa nad progiem opłacalności
AI_MIN_EDGE=0.05
# Jak przekonujący musi być zysk z handlu na papierze (t-stat); wyżej = ostrożniej
AI_MIN_TSTAT=1.5
