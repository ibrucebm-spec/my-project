# Port serwera (aplikacja dostępna tylko na tym komputerze; HOST=0.0.0.0 udostępnia ją w sieci)
PORT=3000

# Źródła danych, po przecinku: myfxbook, mt5
DATA_SOURCES=myfxbook,mt5

# Token wymagany przez endpoint /api/ingest (most MT5). Ustaw długi losowy ciąg!
INGEST_TOKEN=zmien-mnie-na-dlugi-losowy-token

# Myfxbook API (konta z Twojego portfolio Myfxbook)
MYFXBOOK_EMAIL=
MYFXBOOK_PASSWORD=
MYFXBOOK_POLL_SECONDS=60

# Filtry rankingu
MIN_AGE_WEEKS=26
MAX_DRAWDOWN_PCT=30
MIN_SCORE=40
